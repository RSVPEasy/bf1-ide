# Python
__pycache__/
*.pyc

# release build output (build/build_release.py)
build/stripped/
build/pyinstaller/
dist/
*.spec

# per-user settings (recent files, your game/mod folders)
.bf1_ide_settings.json
.bf1_mod_loader.json

# game data and mods - never commit the game's own files or other people's models
*.lvl
*.lvl.bak
*.glb
*.gltf
*.zip

# local-only tools, not part of the release
luac_32.exe
luadec_32.exe
swbf.py

# local copies of ffmpeg - the tools don't use it, and it's over GitHub's 100 MB file limit
ffmpeg.exe
ffprobe.exe
ffplay.exe

# sound/movie name list from Phantom's SoundFMVextractor (GPL-3.0) - users add it themselves
dictionary.txt

# the randomizer is a local tool, not part of the release
bf1_randomizer.py
